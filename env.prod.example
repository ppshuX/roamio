# 生产环境变量副本：在服务器上复制为本仓库根目录的 `.env.prod`，填真实值后再执行 deploy。
#   cp env.prod.example .env.prod && nano .env.prod
# scripts/deploy_uwsgi.sh 在 ROAMIO_SETTINGS=prod 时会自动 source 该文件（可被 ENV_FILE 覆盖）。
#
# 必填项由 roamio/settings/prod.py 校验（见 require_env）。

ALLOWED_HOSTS=roamio.cn,www.roamio.cn

SECRET_KEY=replace-with-long-random-django-secret-key

DB_ENGINE=django.db.backends.mysql
DB_NAME=roamio
DB_USER=roamio_user
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# 建议与 ALLOWED_HOSTS 的访问协议、域名一致（逗号分隔）
CSRF_TRUSTED_ORIGINS=https://roamio.cn,https://www.roamio.cn
CORS_ALLOWED_ORIGINS=https://roamio.cn,https://www.roamio.cn

# Roamio production environment example.
# Copy to .env.prod or point ENV_FILE at a private file. Values are placeholders; never commit real secrets.

# Settings selection
ROAMIO_SETTINGS=prod
DEBUG=False
SECRET_KEY=replace-with-long-random-production-django-secret-key

# Public hosts / reverse proxy origins
ALLOWED_HOSTS=roamio.example.com,www.roamio.example.com
CSRF_TRUSTED_ORIGINS=https://roamio.example.com,https://www.roamio.example.com
CORS_ALLOWED_ORIGINS=https://roamio.example.com,https://www.roamio.example.com
SECURE_SSL_REDIRECT=True

# Production database mode
# Typical current deployment switch: use project-root db.sqlite3 and ignore DB_*.
ROAMIO_USE_SQLITE=1

# MySQL alternative: set ROAMIO_USE_SQLITE=0 and fill every DB_* value.
DB_ENGINE=django.db.backends.mysql
DB_NAME=replace-with-production-database-name
DB_USER=replace-with-production-database-user
DB_PASSWORD=replace-with-production-database-password
DB_HOST=replace-with-production-database-host
DB_PORT=3306

# Redis cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Leave empty when Redis does not require a password.
REDIS_PASSWORD=

# Auth refresh cookie
AUTH_REFRESH_COOKIE_NAME=roamio_refresh_token
AUTH_REFRESH_COOKIE_SECURE=1
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth/
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_AGE=604800

# Email
USE_REAL_EMAIL=1
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=replace-with-email-user
EMAIL_HOST_PASSWORD=replace-with-email-password
DEFAULT_FROM_EMAIL=Roamio <noreply@example.com>

# QQ OAuth
QQ_APP_ID=replace-with-qq-app-id
QQ_APP_KEY=replace-with-qq-app-key
QQ_REDIRECT_URI=https://roamio.example.com/settings/qq/receive_code

# Tencent COS
TENCENT_COS_SECRET_ID=replace-with-cos-secret-id
TENCENT_COS_SECRET_KEY=replace-with-cos-secret-key
TENCENT_COS_BUCKET=replace-with-cos-bucket
TENCENT_COS_REGION=ap-guangzhou

# AI generation
AI_GENERATION_ENABLED=False
QWEN_API_KEY=replace-with-qwen-api-key
QWEN_MODEL=qwen-plus
AI_MAX_TOKENS=8000
AI_TEMPERATURE=0.7

# Map / weather provider
AMAP_API_KEY=replace-with-amap-api-key

# Ralendar integration
RALENDAR_API_URL=https://ralendar.example.com/api/v1
RALENDAR_OAUTH_CLIENT_ID=replace-with-ralendar-client-id
RALENDAR_OAUTH_CLIENT_SECRET=replace-with-ralendar-client-secret
RALENDAR_OAUTH_REDIRECT_URI=https://roamio.example.com/auth/ralendar/callback
RALENDAR_OAUTH_AUTHORIZE_URL=https://ralendar.example.com/oauth/authorize
RALENDAR_OAUTH_TOKEN_URL=https://ralendar.example.com/oauth/token
RALENDAR_OAUTH_USERINFO_URL=https://ralendar.example.com/oauth/userinfo

# Optional Ping++ integration
PINGPP_API_KEY=replace-with-pingpp-api-key
PINGPP_TEST_API_KEY=replace-with-pingpp-test-api-key
PINGPP_APP_ID=replace-with-pingpp-app-id
PINGPP_CALLBACK_URL=https://roamio.example.com/payments/callback
PINGPP_USE_TEST=False

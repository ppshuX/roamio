# Roamio local development environment example.
# Copy to .env for local use. Values are placeholders; never commit real secrets.

# Settings selection
ROAMIO_SETTINGS=dev
DEBUG=True
SECRET_KEY=replace-with-local-dev-secret-key

# Local hosts / browser origins
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Database
# dev.py uses SQLite by default. DB_* is here for base/prod parity or manual MySQL testing.
DB_ENGINE=django.db.backends.mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace-with-local-database-name
DB_USER=replace-with-local-database-user
DB_PASSWORD=replace-with-local-database-password

# Redis cache
# dev.py uses LocMemCache by default. Set ROAMIO_DEV_USE_REDIS=1 to test Redis locally.
ROAMIO_DEV_USE_REDIS=0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Auth refresh cookie
AUTH_REFRESH_COOKIE_NAME=roamio_refresh_token
AUTH_REFRESH_COOKIE_SECURE=0
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth/
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_AGE=604800

# Email
USE_REAL_EMAIL=0
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=replace-with-email-user
EMAIL_HOST_PASSWORD=replace-with-email-password
DEFAULT_FROM_EMAIL=Roamio <noreply@example.com>

# QQ OAuth
QQ_APP_ID=replace-with-qq-app-id
QQ_APP_KEY=replace-with-qq-app-key
QQ_REDIRECT_URI=http://localhost:8080/settings/qq/receive_code

# Tencent COS
TENCENT_COS_SECRET_ID=replace-with-cos-secret-id
TENCENT_COS_SECRET_KEY=replace-with-cos-secret-key
TENCENT_COS_BUCKET=replace-with-cos-bucket
TENCENT_COS_REGION=ap-guangzhou

# AI generation
AI_GENERATION_ENABLED=False
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_TIMEOUT=90
AI_MAX_TOKENS=8000
AI_TEMPERATURE=0.7

# Weather provider. Map SDK/geocoding features are disabled in the app.
AMAP_API_KEY=replace-with-amap-api-key

# Ralendar integration
RALENDAR_API_URL=https://example.com/api/v1
RALENDAR_OAUTH_CLIENT_ID=replace-with-ralendar-client-id
RALENDAR_OAUTH_CLIENT_SECRET=replace-with-ralendar-client-secret
RALENDAR_OAUTH_REDIRECT_URI=http://localhost:8080/auth/ralendar/callback
RALENDAR_OAUTH_AUTHORIZE_URL=https://example.com/oauth/authorize
RALENDAR_OAUTH_TOKEN_URL=https://example.com/oauth/token
RALENDAR_OAUTH_USERINFO_URL=https://example.com/oauth/userinfo
# Explicit local-only mock for the legacy TripEvent sync button.
ROAMIO_MOCK_RALENDAR_EVENT_SYNC=0

# Optional Ping++ integration
PINGPP_API_KEY=replace-with-pingpp-api-key
PINGPP_TEST_API_KEY=replace-with-pingpp-test-api-key
PINGPP_APP_ID=replace-with-pingpp-app-id
PINGPP_CALLBACK_URL=http://localhost:8080/payments/callback
PINGPP_USE_TEST=True

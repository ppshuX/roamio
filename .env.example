# Django
SECRET_KEY=replace-with-local-dev-secret
DEBUG=True

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=roamio_dev
DB_USER=roamio_user
DB_PASSWORD=replace-with-database-password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Email
USE_REAL_EMAIL=0
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=replace-with-email-user
EMAIL_HOST_PASSWORD=replace-with-email-password
DEFAULT_FROM_EMAIL=Roamio <noreply@example.com>

# QQ OAuth
QQ_APP_ID=replace-with-qq-app-id
QQ_APP_KEY=replace-with-qq-app-key
QQ_REDIRECT_URI=http://localhost:8080/settings/qq/receive_code

# Tencent COS
TENCENT_COS_SECRET_ID=replace-with-cos-secret-id
TENCENT_COS_SECRET_KEY=replace-with-cos-secret-key
TENCENT_COS_BUCKET=replace-with-cos-bucket
TENCENT_COS_REGION=ap-guangzhou

# AI
AI_GENERATION_ENABLED=False
QWEN_API_KEY=replace-with-qwen-api-key
QWEN_MODEL=qwen-plus
AI_MAX_TOKENS=8000
AI_TEMPERATURE=0.7

# Ralendar
RALENDAR_API_URL=https://example.com/api/v1
RALENDAR_OAUTH_CLIENT_ID=replace-with-ralendar-client-id
RALENDAR_OAUTH_CLIENT_SECRET=replace-with-ralendar-client-secret
RALENDAR_OAUTH_REDIRECT_URI=http://localhost:8080/auth/ralendar/callback
RALENDAR_OAUTH_AUTHORIZE_URL=https://example.com/oauth/authorize
RALENDAR_OAUTH_TOKEN_URL=https://example.com/oauth/token
RALENDAR_OAUTH_USERINFO_URL=https://example.com/oauth/userinfo

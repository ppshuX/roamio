#!/bin/bash
# 数据库备份脚本配置示例
# 
# 使用方法：
# 1. 复制此文件到服务器：cp backup_database.sh.example ~/.roamio_db_config
# 2. 编辑配置文件，填入真实的数据库信息
# 3. 设置文件权限：chmod 600 ~/.roamio_db_config
# 4. 运行备份脚本：./backup_database.sh

# 数据库连接配置
DB_HOST='your-db-host-here'
DB_PORT='3306'
DB_NAME='roamio_production'
DB_USER='your-db-user-here'
DB_PASSWORD='your-db-password-here'


# Roamio frontend environment example.
# Leave VITE_API_BASE_URL empty to use same-origin API routing.
VITE_API_BASE_URL=
VITE_API_VERSION=v1

# Browser map SDK keys are public at runtime but must not be committed as real values.
# Restrict them by domain in each provider console.
VITE_BAIDU_MAP_AK=replace-with-baidu-browser-map-ak
VITE_AMAP_JS_API_KEY=replace-with-amap-js-api-key
VITE_AMAP_SECURITY_JS_CODE=replace-with-amap-security-js-code

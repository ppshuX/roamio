    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "lint": "eslint --ext .js,.vue src"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bootstrap": "^5.3.8",
    "pinia": "^2.3.1",

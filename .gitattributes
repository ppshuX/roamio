# 确保二进制文件不被 Git 修改
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.mp4 binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# 使用 Git LFS 管理大文件（>1MB）
*.mp3 filter=lfs diff=lfs merge=lfs -text
backend/static/audios/* filter=lfs diff=lfs merge=lfs -text
web/public/music/* filter=lfs diff=lfs merge=lfs -text
web/dist/music/* filter=lfs diff=lfs merge=lfs -text
